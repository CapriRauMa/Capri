--// Target Selector Engine (Tối ưu hóa cho PC / Xeno)
task.spawn(function()
    while task.wait(0.05) do
        local C = getgenv().Capri
        -- Ép bán kính FOV chuẩn trên PC
        local currentFOV = C.SuperZone_Active and 500 or (C.FOV or 250)
        C.FOV = currentFOV
        
        local best, shortest = nil, (C.Aim360 and C.MaxDist or C.FOV) 
        local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        
        if root then
            local potential = {}
            for _, p in pairs(Players:GetPlayers()) do 
                if p ~= LocalPlayer and p.Character then 
                    table.insert(potential, p.Character) 
                end 
            end
            
            if workspace:FindFirstChild("Enemies") then 
                for _, e in pairs(workspace.Enemies:GetChildren()) do 
                    table.insert(potential, e) 
                end 
            end
            
            local mouseLocation = UserInputService:GetMouseLocation()
            
            for _, char in pairs(potential) do
                local hPart = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChild("Humanoid")
                if hPart and hum and hum.Health > 0 then
                    local mag = (hPart.Position - root.Position).Magnitude
                    if mag <= C.MaxDist then
                        local isNPC = not Players:GetPlayerFromCharacter(char)
                        -- Kiểm tra điều kiện bật Aim cho NPC hoặc Player
                        if (isNPC and C.SilentAim_NPC) or (not isNPC and (C.SilentAim_Player or C.CamLock_Player or C.Aim_Active)) then
                            if C.Aim360 then
                                if mag < shortest then
                                    shortest = mag
                                    best = hPart
                                end
                            else
                                local screenPos, onScreen = Camera:WorldToViewportPoint(hPart.Position)
                                if onScreen then
                                    -- Tính khoảng cách từ tâm chuột (hoặc tâm màn hình) đến đối tượng
                                    local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - mouseLocation).Magnitude
                                    if screenDist <= C.FOV and screenDist < shortest then
                                        shortest = screenDist
                                        best = hPart
                                    end
                                end
                            end
                        end
                    end
                end
            end
            C.CurrentTarget = best
        end
    end
end)
