function AttackNoCoolDown()
    local char = Player.Character
    if not char then return end
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then return end

    local pivotPos = char:GetPivot().Position
    if tool:FindFirstChild("LeftClickRemote") then
        local idx = 1
        local enemiesFolder = Workspace:FindFirstChild("Enemies")
        if enemiesFolder then
            for _, mob in ipairs(enemiesFolder:GetChildren()) do
                local hrp = mob:FindFirstChild("HumanoidRootPart")
                if hrp and isAliveMob(mob) and (hrp.Position - pivotPos).Magnitude <= 60 then
                    local dir = (hrp.Position - pivotPos).Unit
                    pcall(function()
                        tool.LeftClickRemote:FireServer(dir, idx)
                    end)
                    idx = idx >= 1000000000 and 1 or (idx + 1)
                end
            end
        end
    else
        local targets = {}
        local lastHead = nil
        local enemiesFolder = Workspace:FindFirstChild("Enemies")
        if enemiesFolder then
            for _, mob in ipairs(enemiesFolder:GetChildren()) do
                if not mob:GetAttribute("IsBoat") and isAliveMob(mob) then
                    local head = mob:FindFirstChild("Head") or mob:FindFirstChild("HumanoidRootPart")
                    if head and (pivotPos - head.Position).Magnitude <= 60 then
                        table.insert(targets, { mob, head })
                        lastHead = head
                    end
                end
            end
        end
        if not lastHead or #targets == 0 then return end
        pcall(function()
            local net = ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Net")
            net:WaitForChild("RE/RegisterAttack"):FireServer(1e-9)
            net:WaitForChild("RE/RegisterHit"):FireServer(lastHead, targets)
        end)
    end
end

-- Gom quái xung quanh về điểm trung tâm (centerCF)
local function BringMobsTo(centerCF, targetNameOnly)
    if not _G.BringMob or not centerCF then return end
    pcall(function()
        local centerPos = centerCF.Position
        local enemiesFolder = Workspace:FindFirstChild("Enemies")
        if not enemiesFolder then return end

        for _, mob in ipairs(enemiesFolder:GetChildren()) do
            if isAliveMob(mob) then
                local nameMatch = (not targetNameOnly) or (mob.Name == targetNameOnly)
                if nameMatch then
                    local mHrp = mob:FindFirstChild("HumanoidRootPart")
                    local mHum = mob:FindFirstChildOfClass("Humanoid")
                    if mHrp and mHum then
                        local dist = (mHrp.Position - centerPos).Magnitude
                        if dist > 6 and dist <= _G.BringRange then
                            mHrp.Size = Vector3.new(50, 50, 50)
                            mHrp.CanCollide = false
                            mHrp.CFrame = centerCF * CFrame.new(math.random(-4, 4), 0, math.random(-4, 4))
                            pcall(function()
                                mHrp.AssemblyLinearVelocity = Vector3.zero
                            end)
                        end
                    end
                end
            end
        end
    end)
end

local function FindTargetMob(selectedName)
    local hrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local bestMob = nil
    local shortest = _G.FarmSearchRange

    local function checkContainer(container)
        if not container then return end
        for _, mob in ipairs(container:GetChildren()) do
            if isAliveMob(mob) then
                if not selectedName or selectedName == "" or selectedName == "Không có NPC/Quái" or mob.Name == selectedName then
                    local mHrp = mob:FindFirstChild("HumanoidRootPart")
                    if mHrp then
                        local d = (hrp.Position - mHrp.Position).Magnitude
                        if d < shortest then
                            shortest = d
                            bestMob = mob
                        end
                    end
                end
            end
        end
    end

    checkContainer(Workspace:FindFirstChild("Enemies"))
    if not bestMob then
        checkContainer(Workspace)
    end
    return bestMob
end

