-- Vòng lặp Auto Farm + Gom Quái
task.spawn(function()
    while task.wait(0.08) do
        if _G.AutoFarmNPC then
            pcall(function()
                local mob = FindTargetMob(_G.SelectedNPC)
                if mob then
                    local mHrp = mob:FindFirstChild("HumanoidRootPart")
                    local mHum = mob:FindFirstChildOfClass("Humanoid")
                    local hrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")

                    if mHrp and mHum and hrp then
                        local anchorCF = mHrp.CFrame
                        repeat
                            task.wait(_G.Fast_Delay)
                            if not _G.AutoFarmNPC or not mob.Parent or mHum.Health <= 0 then
                                break
                            end

                            local currentMobCF = mHrp.CFrame
                            if _G.BringMob then
                                BringMobsTo(currentMobCF, _G.SelectedNPC)
                            end

                            local farmCF = currentMobCF * Pos
                            if (farmCF.Position - hrp.Position).Magnitude > 4 then
                                BKP(farmCF)
                            end

                            AutoHaki()
                            EquipTool(SelectWeapon)
                            AttackNoCoolDown()
                        until not _G.AutoFarmNPC or not mob.Parent or mHum.Health <= 0
                    end
                end
            end)
        elseif _G.BringMob then
            pcall(function()
                local hrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    BringMobsTo(hrp.CFrame, nil)
                end
            end)
        end
    end
end)

