local function isAliveMob(model)
    if not model or not model.Parent then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    local hrp = model:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp or hum.Health <= 0 then return false end
    if Players:GetPlayerFromCharacter(model) then return false end
    return true
end

local function ScanMapNPCs()
    local names = {}
    local seen = {}

    local function collectFromContainer(container)
        if not container then return end
        for _, obj in ipairs(container:GetChildren()) do
            if obj:IsA("Model") and isAliveMob(obj) then
                if not seen[obj.Name] then
                    seen[obj.Name] = true
                    table.insert(names, obj.Name)
                end
            end
        end
    end

    collectFromContainer(Workspace:FindFirstChild("Enemies"))
    collectFromContainer(Workspace)

    table.sort(names)
    if #names == 0 then
        table.insert(names, "Không có NPC/Quái")
    end
    return names
end

function BKP(targetCF)
    local hrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp or not targetCF then return end
    hrp.CFrame = targetCF
    task.wait()
    if hrp and hrp.Parent then
        hrp.CFrame = targetCF
    end
end

function EquipTool(toolName)
    if not toolName then return end
    local char = Player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local tool = Player.Backpack:FindFirstChild(toolName)
    if hum and tool and tool:IsA("Tool") then
        hum:EquipTool(tool)
    end
end

